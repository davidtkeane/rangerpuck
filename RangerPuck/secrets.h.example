// Copy this file to secrets.h and fill it in.
//
//   cp secrets.h.example secrets.h
//
// secrets.h is gitignored and must NEVER be read, printed or pasted into a chat.
// Same rule as the .env files: secrets stay in the file.

#define WIFI_SSID  "your-network-name"
#define WIFI_PASS  "your-wifi-password"

// The name the board announces itself as on the network.
// Reach it at http://rangerpuck.local — never a hard-coded IP, DHCP moves those.
#define PUCK_HOSTNAME "rangerpuck"
